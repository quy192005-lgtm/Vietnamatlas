# Vietnam Atlas Admin Security Configuration (Template)
# Copy this to .env.local and set your private credentials
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_private_password
ADMIN_SESSION_SECRET=your_random_secret_session_key

# Supabase Online Database Configuration (Free Tier)
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
